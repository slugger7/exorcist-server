APP_ENV=dev
LOG_LEVEL=debug
DEBUG_SQL=true
PORT=8181
SECRET=some-secure-secret
JOB_RUNNER=true
DISABLE_JOBS=generate_checksum
CORS_ORIGINS="http://localhost:5173;http://localhost:8181;http://192.168.1.110:5173;http://192.168.1.110:8181"
WEBSOCKET_HEARTBEAT_INTERVAL=15000

ASSETS=./.temp/assets
WEB=web

DATABASE_PASSWORD=some-secure-password
DATABASE_USER=exorcist
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=exorcist
DATABASE_CONNECTION_STRING=postgres://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}?sslmode=disable


GHOST_DB_PATH=./.temp/Ghost-dev.db
